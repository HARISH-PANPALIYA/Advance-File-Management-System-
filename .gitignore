# =================================================================
# FileGuard Git Ignore Configuration
# =================================================================

# C++ Build Output & Artifacts
safevault_cpp/build/
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.cmake
!CMakeLists.txt
*.o
*.obj
*.exe
*.a
*.lib
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp

# Node.js and Frontend Build Output
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Databases, Storage & Recovery Artifacts
storage/
.safevault_storage/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Test Artifacts & Sandboxes
test_sandbox/
safevault_tests/
test_bench.json
test_req.json
*.tmp
*.log

# Runtime Watched Sandbox (dynamic testing directory)
watched/*
!watched/1/
!watched/.gitkeep

# Python Virtual Environments & Cache
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
